<?xml version="1.0"?>
<!--
  Minimal launch file for deepracer_env gymnasium usage.
  Starts the Gazebo world and car without any AWS S3/Kinesis dependencies.
  Required env vars: WORLD_NAME
  Optional env vars: ENABLE_GUI (default: false),
    GYM_DR_CAMERAS (default: all) — comma list of racecar names that keep the
    primary camera; cars NOT listed spawn camera-off (feature-obs path).
    Multi-car (GYM_DR_N_CARS) is wired in MC-3.
-->
<launch>
  <!-- multicar + per-car lists scale with GYM_DR_N_CARS (default 1 = single car).
       The native multicar launch path spawns racecar_0/racecar_1 (2 cars); >2
       needs more car blocks in racetrack_with_racecar.launch (follow-up). -->
  <arg name="n_cars" default="$(optenv GYM_DR_N_CARS 1)" />
  <include file="$(find deepracer_simulation_environment)/launch/racetrack_with_racecar.launch">
    <arg name="world_name"                   value="$(env WORLD_NAME)" />
    <arg name="kinesis_video_stream_names"   value="" />
    <arg name="multicar"                     value="$(eval int(arg('n_cars')) > 1)" />
    <arg name="body_shell_types"             value="$(eval ('deepracer,' * int(arg('n_cars'))).rstrip(','))" />
    <arg name="simapp_versions"              value="$(eval ('5.0,' * int(arg('n_cars'))).rstrip(','))" />
    <arg name="publish_to_kinesis_stream"    value="false" />
    <arg name="gui"                          value="$(optenv ENABLE_GUI false)" />
    <arg name="racecars_with_cameras"        value="$(optenv GYM_DR_CAMERAS racecar,racecar_0,racecar_1,racecar_2,racecar_3,racecar_4,racecar_5,racecar_6,racecar_7)" />
  </include>
</launch>

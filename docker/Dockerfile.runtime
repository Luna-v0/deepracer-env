# syntax=docker/dockerfile:1
#################################################################################
#  deepracer-env — Stage 3 of 3: RUNTIME                                        #
#                                                                               #
#  The final image dr-gym builds FROM. It starts from the Lyrical/Jetty         #
#  substrate (which already carries gz Jetty, ros2_control, the ros_gz bridge), #
#  copies the colcon install tree from the bundle stage into /opt/simapp,        #
#  installs the deepracer_env Python package (no AWS deps — Route B/strip), and #
#  wires the entrypoint that exports the two gz search paths the port needs.    #
#################################################################################
ARG BUNDLE_PREFIX=deepracer-env-build-bundle
ARG BUNDLE_TAG=lyrical
ARG CORE_PREFIX=deepracer-env-build-core
ARG CORE_TAG=lyrical

FROM ${BUNDLE_PREFIX}:${BUNDLE_TAG} AS bundle
FROM ${CORE_PREFIX}:${CORE_TAG}

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=lyrical

# Python deps for deepracer_env (training/runtime). Installed explicitly so the
# package itself can go in --no-deps and never drag the stripped AWS stack.
# Ubuntu 26.04 is PEP-668 externally-managed → --break-system-packages.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        gymnasium numpy scipy shapely opencv-python-headless pillow

# Compiled workspace (deepracer_simulation_environment share: urdf/worlds/models/
# meshes/routes/config/launch) from the bundle stage.
COPY --from=bundle /opt/bundle/install /opt/simapp

# The Python env package, without its (AWS-laden) declared deps.
COPY deepracer_env/ /tmp/deepracer-env/deepracer_env/
COPY pyproject.toml VERSION /tmp/deepracer-env/
RUN python3 -m pip install --no-cache-dir --break-system-packages --no-deps /tmp/deepracer-env \
    && rm -rf /tmp/deepracer-env

COPY docker/files/entrypoint-lyrical.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV COLCON_CURRENT_PREFIX=/opt/simapp

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

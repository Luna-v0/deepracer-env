# syntax=docker/dockerfile:1
#################################################################################
#  deepracer-env — Stage 1 of 3: BASE (substrate only, no DeepRacer logic)      #
#                                                                               #
#  ROS 2 Lyrical Luth (Ubuntu 26.04 "resolute") + Gazebo Jetty (gz-sim 10.x).   #
#  Gazebo arrives via the ROS *vendor* packages from packages.ros.org           #
#  (ros-lyrical-gz-sim-vendor, pulled transitively by ros-gz-sim) — we do NOT   #
#  add the osrf gazebo apt list, which is the unsupported path on Lyrical.      #
#                                                                               #
#  This stage installs the simulation substrate (Jetty, ros2_control, the       #
#  ros_gz bridge, simulation_interfaces) and the colcon/ament toolchain. It     #
#  deliberately contains NO workspace sources: the DeepRacer packages are       #
#  built in Dockerfile.build on top of this image. Keeping the substrate in a   #
#  separate, rarely-changing layer makes the (frequent) workspace rebuild cheap.#
#################################################################################
FROM ros:lyrical-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=lyrical

# --- Substrate packages -------------------------------------------------------
# Pinned-by-distro (apt) rather than by exact version: Lyrical is a single LTS
# track, so "ros-lyrical-*" already pins the supported set. See the project
# memory note "lyrical-jetty-substrate-verified" for the audited version table.
RUN apt-get update && apt-get install -y --no-install-recommends \
        # build toolchain
        build-essential \
        cmake \
        git \
        python3-colcon-common-extensions \
        python3-pip \
        python3-vcstool \
        wget \
        # Gazebo Jetty + the ROS<->gz bridge (vendor pkgs come in transitively)
        ros-lyrical-ros-gz-sim \
        ros-lyrical-ros-gz-bridge \
        ros-lyrical-ros-gz-image \
        ros-lyrical-ros-gz-interfaces \
        # ros2_control + the Gazebo Sim hardware plugin (the drive stack)
        ros-lyrical-gz-ros2-control \
        ros-lyrical-ros2-control \
        ros-lyrical-ros2-controllers \
        # the simulator-agnostic sim-control standard (Route B core)
        ros-lyrical-simulation-interfaces \
        # robot description + sensor decode
        ros-lyrical-xacro \
        ros-lyrical-robot-state-publisher \
        ros-lyrical-joint-state-publisher \
        ros-lyrical-cv-bridge \
        ros-lyrical-image-transport \
    && rm -rf /var/lib/apt/lists/*

# rosdep ships pre-initialised in the base image; refresh for the Lyrical list
# so Dockerfile.build's `rosdep install` over the ported workspace resolves.
RUN rosdep update --rosdistro=${ROS_DISTRO} || true

# Headless render: gz-sim's GUI/sensors render through OGRE-next. Default to the
# software GL path so `gz sim -s` (server) runs with no X server; the GUI used
# for the demo recording is driven under xvfb in the runtime stage.
ENV GZ_IP=127.0.0.1 \
    LIBGL_ALWAYS_SOFTWARE=1

CMD ["bash"]
